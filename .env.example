# Auto-Rust Environment Configuration
# Updated: April 2026
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here_xxxxxxxxxxxxxxxxxxxxxxxx
RUSTC_WRAPPER=sccache
RUST_LOG=debug
# .env based mouse calibration choose either mac / windows / linux
native_click_calibration=mac

# Browser Ports
BRAVE_PORT_START=9001
BRAVE_PORT_END=9050
CHROME_PORT_START=9201
CHROME_PORT_END=9250

# =============================================================================
# LLM Configuration
# =============================================================================
# Provider: "ollama" or "openrouter"
LLM_PROVIDER=ollama

# Global LLM settings (can be overridden by provider-specific vars below)
# Range: 0.0 - 2.0 (higher = more creative/random, lower = more deterministic)
# Recommended for Twitter replies to avoid detection: 0.85 - 0.95
LLM_TEMPERATURE=0.85

# OpenRouter Settings (get key from https://openrouter.ai/keys)
OPENROUTER_API_KEY=sk-or-v1-your_openrouter_api_key_here_xxxxxxxxxxxxxxxxxxxx
OPENROUTER_MODEL=tencent/hy3-preview:free
OPENROUTER_MODEL_FALLBACK=nvidia/nemotron-3-super-120b-a12b:free
OPENROUTER_MODEL_FALLBACK_2=minimax/minimax-m2.5:free
OPENROUTER_MODEL_FALLBACK_3=nvidia/nemotron-3-nano-30b-a3b:free
OPENROUTER_MODEL_FALLBACK_4=openrouter/free
# OPENROUTER_TEMPERATURE=0.85

# Ollama Settings (local)
# Install Ollama: https://ollama.ai/download
# Recommended Models (Sorted by quality, best to least):
# -----------------------------------------------------------------------------
# Model Name                            | Est. VRAM | Reply Quality Index
# -----------------------------------------------------------------------------
# 1. Gemma 4-12B (Best Quality)         | ~9.5 GB   | 100% (Baseline)
#    - Model: hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
# 2. Gemma 4-E4B (Great, Recommended)   | ~7.5 GB   | 90%
#    - Model: hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
# 3. Qwen 2.5 VL 7B (Vision/Reasoning)  | ~6.5 GB   | 86%
#    - Model: hf.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF:Q4_K_M (~4.7 GB size)
# 4. Qwen 2.5 7B (Standard mid-size)    | ~6.0 GB   | 85%
#    - Model: qwen2.5:7b
# 5. Llama 3.1 8B (Robust standard)     | ~6.5 GB   | 82%
#    - Model: llama3.1:8b
# 6. Gemma 4-E2B (Good, Balanced)       | ~4.5 GB   | 78%
#    - Model: hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL
# 7. Phi 3.5 Mini (Very smart small)    | ~2.6 GB   | 70%
#    - Model: phi3.5:latest (~2.2 GB size)
# 8. Llama 3.2 3B (Lightweight/Fast)    | ~2.5 GB   | 62%
#    - Model: llama3.2:3b
# -----------------------------------------------------------------------------
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
# Alternative models:
# OLLAMA_MODEL=hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
# OLLAMA_MODEL=hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL
# OLLAMA_MODEL=hf.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF:Q4_K_M
# OLLAMA_MODEL=llama3.2:3b
# OLLAMA_MODEL=qwen2.5:7b
# OLLAMA_TEMPERATURE=0.85

# =============================================================================
# Twitter Activity Settings
# =============================================================================
TWITTER_LLM_ENABLED=true
TWITTER_LLM_PROVIDER=ollama
TWITTER_LLM_MODEL=hf.co/unsloth/gemma-4-E4B-it-qat-GGUF:UD-Q4_K_XL
# Alternative models:
# TWITTER_LLM_MODEL=hf.co/unsloth/gemma-4-12B-it-qat-GGUF:UD-Q4_K_XL
# TWITTER_LLM_MODEL=hf.co/unsloth/gemma-4-E2B-it-qat-GGUF:UD-Q4_K_XL
# TWITTER_LLM_MODEL=hf.co/unsloth/Qwen2.5-VL-7B-Instruct-GGUF:Q4_K_M
# TWITTER_LLM_MODEL=llama3.2:3b

# Engagement Limits (Conservative, safe for testing)
TWITTER_MAX_LIKES=1
TWITTER_MAX_RETWEETS=1
TWITTER_MAX_FOLLOWS=1
TWITTER_MAX_REPLIES=1
TWITTER_MAX_THREAD_DIVES=20
TWITTER_MAX_TOTAL_ACTIONS=10
# ======================
TWITTER_LIKE_PROBABILITY=0.02         # 2% chance to like a tweet on home screen
TWITTER_RETWEET_PROBABILITY=0.05    # 5% chance to retweet
TWITTER_QUOTE_PROBABILITY=0.05       # 5% chance to quote tweet
TWITTER_FOLLOW_PROBABILITY=0.05      # 5% chance to follow author
TWITTER_REPLY_PROBABILITY=0.4       # 4% chance to reply
TWITTER_THREAD_DIVE_PROBABILITY=0.04 # 4% chance to dive into thread

# =============================================================================
# Browser Configuration
# =============================================================================
ROXYBROWSER_API_URL=http://127.0.0.1:50000/
ROXYBROWSER_API_KEY=your_roxybrowser_api_key_here_xxxxxxxx

CURSOR_OVERLAY_MS=50

# Orchestrator Settings
MAX_GLOBAL_CONCURRENCY=20
TASK_TIMEOUT_MS=600000
MAX_RETRIES=2

# ms for the target element to stop moving or layout-shifting before using it.
NATIVE_INTERACTION_STABILITY_WAIT_MS=3000
# ms to find a valid visible target or compute the point.
NATIVE_INTERACTION_RESOLVE_TIMEOUT_MS=2000
# pause after the native move/click motion to let the UI settle before the next step.
NATIVE_INTERACTION_SETTLE_MS=100
