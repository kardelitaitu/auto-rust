#!/bin/sh
# pre-commit hook: reject commits with unformatted Rust code.
# Installed by scripts/setup-hooks.sh — do not edit .git/hooks/pre-commit directly.
# Edit this source file instead, then re-run setup-hooks.sh to apply changes.
#
# Runs `cargo fmt --check` on all Rust files. Exits non-zero if any
# formatting issues are found, printing the diff so you can fix with
# `cargo fmt` or `cargo fmt -- <file>`.

# NOTE: Do NOT use `set -e` here.
# We need to capture the exit code of cargo fmt and display a helpful
# message before exiting. `set -e` would abort the script before the
# error message block can run.

# Only check Rust files. If no .rs files are staged, skip.
staged_rs=$(git diff --cached --name-only --diff-filter=ACMR | grep '[.]rs$' || true)
if [ -z "$staged_rs" ]; then
    exit 0
fi

# Run cargo fmt --check on the whole project.
# This is fast (no compilation) and catches formatting issues reliably.
cargo fmt --check 2>/dev/null
exit_code=$?

if [ $exit_code -ne 0 ]; then
    echo ""
    echo "❌  Formatting issues found. Commit rejected."
    echo "    Run 'cargo fmt' to auto-fix, then stage and commit again."
    echo ""
    # Show a clean summary of what's wrong
    cargo fmt --check 2>&1 | head -50
    exit 1
fi

exit 0
